[Unit]
Description=iNPU Inference Service (inpu)
Documentation=https://github.com/wen/iNPU
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/inpu serve qwen2.5 --port 52625 --host 127.0.0.1
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
